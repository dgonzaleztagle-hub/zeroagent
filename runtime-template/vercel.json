{
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,agent-package.json}",
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/agenda/google-contacts/cron", "schedule": "0 * * * *" }
  ]
}
