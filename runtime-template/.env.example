# Credenciales se configuran sólo en la instalación del cliente.
PORT=3000
# preview_local permite operar sin claves únicamente en tu PC. Staging y producción fallan cerrados.
RUNTIME_MODE=production
CHANNEL_PROVIDER=zavu
# Sólo para pruebas locales explícitas con CHANNEL_PROVIDER=generic_webhook.
GENERIC_WEBHOOK_SECRET=
# Protege el chat web de prueba. Obligatorio en staging y producción.
PREVIEW_ACCESS_KEY=pon-una-clave-larga-y-unica
# Entrevista privada del dueño. Usa otra clave larga y mantenla mientras el runtime esté activo.
ONBOARDING_ACCESS_TOKEN=pon-otra-clave-larga-y-unica
# Acceso de dueño/equipo a la consola operativa. Obligatorio en staging y producción.
DASHBOARD_ACCESS_KEY=pon-una-clave-para-el-equipo
# Responsable inicial de la operación. Podrá asignar conversaciones y pausar la IA.
CLIENT_OWNER_NAME=
CLIENT_OWNER_EMAIL=
# En Vercel el disco no es persistente: envía feedback a tu API/Supabase.
FEEDBACK_WEBHOOK_URL=
# URL segura del monitor, ej. https://monitor.tudominio.cl/api/clients/CLIENTE/ai-usage
METRICS_WEBHOOK_URL=
METRICS_TOKEN=
# Protege la ejecución HTTP del worker de alertas. Para reintentos recurrentes,
# programa también `npm run dispatch:outbox` en el entorno del cliente.
OUTBOX_DISPATCH_TOKEN=
ZAVUDEV_API_KEY=
ZAVUDEV_SENDER_ID=
ZAVUDEV_WEBHOOK_SECRET=
# Timeout de cada request al SDK (3-30 s) y lease de procesamiento (30-900 s).
ZAVUDEV_TIMEOUT_MS=15000
ZAVU_WEBHOOK_LEASE_SECONDS=300
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cifra AES-256-GCM las claves BYOK guardadas en el Supabase del negocio, y también el
# refresh_token de Google Calendar si se conecta (ver más abajo). Genera 32 bytes aleatorios
# en base64; obligatorio si se ofrece "Usar mi propia API key" o la conexión a Google Calendar.
AI_CREDENTIALS_ENCRYPTION_KEY=
# Cliente OAuth de Google Cloud a nivel PRODUCTO ZeroAgent — el mismo par para todos los
# clientes (cada negocio hace su propio consentimiento y genera su propio refresh_token).
# Ver ~/.claude/credenciales/zeroagent-google-calendar.md. Sólo obligatorio si se ofrece
# conectar Google Calendar.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opcional: fuerza el dominio base para el redirect_uri (ej. https://franciskom.cl) en vez de
# derivarlo del header Host de la request. Debe coincidir EXACTO con una redirect URI
# registrada en el cliente OAuth de Google Cloud, incluyendo /auth/google/callback.
GOOGLE_OAUTH_REDIRECT_BASE_URL=
# Hosts OpenAI-compatible adicionales permitidos para BYOK, separados por coma. OpenAI y
# Groq ya están allowlisted; no se aceptan hosts arbitrarios ni redes privadas.
AI_ALLOWED_COMPATIBLE_HOSTS=
# Compatibilidad de instalación anterior/preview. En producción se puede usar esto o BYOK
# seleccionado desde el panel.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Para Qwen u otro proveedor OpenAI-compatible.
LLM_BASE_URL=
# Alias nativo opcional para Groq; nunca guardar la clave en agent-package.json.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Centinela opcional: alertas internas a tu Telegram, no al cliente.
# SENTINEL_TELEGRAM_BOT_TOKEN=
# SENTINEL_TELEGRAM_CHAT_ID=
